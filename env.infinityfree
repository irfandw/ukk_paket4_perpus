APP_NAME="Perpustakaan Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI.infinityfreeapp.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=sql.infinityfree.com
DB_PORT=3306
DB_DATABASE=GANTI_DB
DB_USERNAME=GANTI_USER
DB_PASSWORD=GANTI_PASS

CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
